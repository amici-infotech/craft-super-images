{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Playground"|t('super-images') %}
{% set selectedSubnavItem = 'playground' %}
{% set crumbs = [
    { label: "Super Images"|t('super-images'), url: cpUrl('super-images') },
] %}

{% css %}
.si-play {
    display: grid;
    gap: 16px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
}
.si-play *,
.si-play *::before,
.si-play *::after {
    box-sizing: border-box;
}
.si-play__form,
.si-play__summary,
.si-play__original,
.si-play__variant,
.si-play__code,
.si-play__metric,
.si-play__card {
    min-width: 0;
}
.si-play__form {
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    background: #fff;
    padding: clamp(14px, 2vw, 22px);
}
.si-play__meta {
    margin-top: 4px;
    color: #6c757d;
    font-size: 12px;
    line-height: 1.45;
    overflow-wrap: anywhere;
}
.si-play__summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}
@media (min-width: 720px) {
    .si-play__summary {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }
}
.si-play__metric {
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    background: #fff;
    padding: 12px 14px;
}
.si-play__metric span {
    display: block;
}
.si-play__metric-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #6c757d;
    margin-bottom: 6px;
}
.si-play__metric-value {
    font-size: clamp(15px, 2.4vw, 18px);
    font-weight: 600;
    overflow-wrap: anywhere;
}
.si-play__original {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    background: #fff;
    padding: clamp(12px, 2vw, 16px);
}
@media (min-width: 720px) {
    .si-play__original {
        grid-template-columns: minmax(140px, 220px) minmax(0, 1fr);
    }
}
.si-play__original-media {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: #f3f5f7;
}
.si-play__original-media img,
.si-play__thumb {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    background: #eef1f4;
}
.si-play__original-media canvas[data-image-cover],
.si-play__thumb-wrap canvas[data-image-cover] {
    display: none !important;
}
.si-play__variant {
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    background: #fff;
    padding: clamp(12px, 2vw, 18px);
}
.si-play__variant h3 {
    margin: 0 0 12px;
    font-size: 15px;
}
.si-play__formats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
}
@media (min-width: 560px) {
    .si-play__formats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (min-width: 1100px) {
    .si-play__formats {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
}
.si-play__card {
    border: 1px solid #edf0f3;
    border-radius: 8px;
    background: #fafbfc;
    padding: 12px;
    display: grid;
    gap: 10px;
}
.si-play__card.is-error {
    border-color: #f5c2c7;
    background: #fff5f5;
}
.si-play__card-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
}
.si-play__card-head strong {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.04em;
}
.si-play__card-meta {
    color: #6c757d;
    font-size: 12px;
}
.si-play__thumb-wrap {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 6px;
    background: #eef1f4;
    aspect-ratio: 4 / 3;
}
.si-play__thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}
.si-play__card-stats {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: #3f4d5a;
    display: grid;
    gap: 4px;
}
.si-play__card-stats code {
    display: block;
    overflow-wrap: anywhere;
    word-break: break-word;
}
.si-play__error {
    margin: 0;
    color: #c62828;
    font-size: 12px;
}
.si-play__code {
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    background: #fff;
    padding: clamp(12px, 2vw, 18px);
}
.si-play__code pre {
    margin: 0 0 12px;
    overflow: auto;
    max-width: 100%;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}
.si-play__code pre:last-child {
    margin-bottom: 0;
}
.si-play__live {
    margin: 0 0 14px;
    overflow: hidden;
    border-radius: 8px;
    background: #eef1f4;
}
.si-play__live picture,
.si-play__live img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
}
.si-play__live canvas[data-image-cover] {
    display: none !important;
}
.si-play__intro {
    margin: 0;
    color: #3f4d5a;
}
{% endcss %}

{% block content %}
    <div class="si-play">
        <p class="si-play__intro">
            {{ "Choose an asset and a profile. Every configured variant × format is generated and previewed in a responsive grid."|t('super-images') }}
        </p>

        {% if error %}
            <div class="pane" style="border-left: 3px solid #cf1124; margin: 0; padding: 12px 16px;">
                {{ error|e }}
            </div>
        {% endif %}

        <form method="post" accept-charset="UTF-8" class="si-play__form">
            {{ actionInput('super-images/playground/generate') }}
            {{ csrfInput() }}

            {{ forms.elementSelectField({
                first: true,
                label: "Asset"|t('super-images'),
                instructions: "Pick one image asset."|t('super-images'),
                id: 'assetId',
                name: 'assetId',
                elementType: assetElementType,
                limit: 1,
                single: true,
                elements: selectedAssets,
                criteria: { kind: 'image' },
                sources: '*',
                selectionLabel: "Choose an image"|t('super-images'),
                required: true,
            }) }}

            {{ forms.selectField({
                label: "Profile"|t('super-images'),
                instructions: "Generates all variants and formats configured on this profile."|t('super-images'),
                id: 'profile',
                name: 'profile',
                options: profileSelectOptions,
                value: posted.profile,
            }) }}

            <p class="si-play__meta" id="si-play-meta" hidden>
                {{ "Will generate"|t('super-images') }}:
                <strong id="si-play-meta-count">0</strong>
                {{ "images"|t('super-images') }}
                (<span id="si-play-meta-detail"></span>)
            </p>

            <div class="buttons" style="margin-top: 14px;">
                <button type="submit" class="btn submit">{{ "Generate profile previews"|t('super-images') }}</button>
            </div>
        </form>

        {% js %}
            (() => {
                const profiles = {{ profiles|json_encode|raw }};
                const select = document.getElementById('profile');
                const meta = document.getElementById('si-play-meta');
                const countEl = document.getElementById('si-play-meta-count');
                const detailEl = document.getElementById('si-play-meta-detail');

                if (!select || !meta || !countEl || !detailEl) {
                    return;
                }

                const updateMeta = () => {
                    const profile = profiles[select.value] || null;
                    if (!profile) {
                        meta.hidden = true;
                        return;
                    }

                    const variants = Array.isArray(profile.variants) ? profile.variants : [];
                    const formats = Array.isArray(profile.formats) ? profile.formats : [];
                    const unitCount = Number(profile.unitCount);
                    const count = Number.isFinite(unitCount)
                        ? unitCount
                        : (variants.length * formats.length);

                    countEl.textContent = String(count);
                    detailEl.textContent = variants.join(', ') + ' · ' + formats.join(', ');
                    meta.hidden = false;
                };

                select.addEventListener('change', updateMeta);
                updateMeta();

                // Craft CP AnimationBlocker covers .webp with a canvas. Opt our previews out.
                document.querySelectorAll('.si-play img[src*=".webp"]').forEach((img) => {
                    if (!img.dataset.animationController) {
                        img.dataset.animationController = 'off';
                    }
                });
            })();
        {% endjs %}

        {% if result %}
            <section class="si-play__summary">
                <div class="si-play__metric">
                    <span class="si-play__metric-label">{{ "Profile"|t('super-images') }}</span>
                    <span class="si-play__metric-value">{{ result.profile }}</span>
                </div>
                <div class="si-play__metric">
                    <span class="si-play__metric-label">{{ "Generated"|t('super-images') }}</span>
                    <span class="si-play__metric-value">{{ result.summary.generated }}/{{ result.summary.planned }}</span>
                </div>
                <div class="si-play__metric">
                    <span class="si-play__metric-label">{{ "Failed"|t('super-images') }}</span>
                    <span class="si-play__metric-value" style="color: {{ result.summary.failed ? '#c62828' : 'inherit' }};">{{ result.summary.failed }}</span>
                </div>
                <div class="si-play__metric">
                    <span class="si-play__metric-label">{{ "Duration"|t('super-images') }}</span>
                    <span class="si-play__metric-value">{{ result.summary.durationMs|number_format(0) }} ms</span>
                </div>
            </section>

            <section class="si-play__original">
                <div class="si-play__original-media">
                    {% if result.assetUrl %}
                        <img
                            src="{{ result.assetUrl }}"
                            alt="{{ result.assetTitle|e }}"
                            data-animation-controller="off"
                            loading="lazy"
                            decoding="async"
                        >
                    {% endif %}
                </div>
                <div>
                    <h2 style="margin-top:0;">{{ "Original"|t('super-images') }}</h2>
                    <p style="margin:0 0 8px;"><strong>{{ result.assetTitle }}</strong> <span class="light">#{{ result.assetId }}</span></p>
                    <p class="light" style="margin:0; overflow-wrap:anywhere;">
                        {{ result.original.width }}×{{ result.original.height }}
                        · {{ result.original.mime }}
                        · {{ result.original.size|filesize }}
                        · {{ result.original.filename }}
                    </p>
                </div>
            </section>

            {% for variant, items in result.byVariant %}
                <section class="si-play__variant">
                    <h3>{{ "Variant"|t('super-images') }}: <code>{{ variant }}</code></h3>
                    <div class="si-play__formats">
                        {% for item in items %}
                            <article class="si-play__card{% if not item.success %} is-error{% endif %}">
                                <div class="si-play__card-head">
                                    <strong>{{ item.format }}</strong>
                                    {% if item.success %}
                                        <span class="si-play__card-meta">{{ item.width }}×{{ item.height }}</span>
                                    {% else %}
                                        <span class="si-play__card-meta" style="color:#c62828;">{{ "Failed"|t('super-images') }}</span>
                                    {% endif %}
                                </div>

                                {% if item.success and item.url %}
                                    <a class="si-play__thumb-wrap" href="{{ item.url }}" target="_blank" rel="noopener">
                                        <img
                                            src="{{ item.url }}"
                                            alt="{{ variant }} {{ item.format }}"
                                            data-animation-controller="off"
                                            loading="lazy"
                                            decoding="async"
                                        >
                                    </a>
                                    <ul class="si-play__card-stats">
                                        <li>{{ item.size|filesize }} · {{ item.mime }}</li>
                                        <li>{{ item.durationMs|number_format(1) }} ms</li>
                                        {% if item.percentSaved is not null %}
                                            <li>{{ item.percentSaved }}% {{ "vs original"|t('super-images') }}</li>
                                        {% endif %}
                                        <li class="light"><code>{{ item.storagePath }}</code></li>
                                    </ul>
                                {% else %}
                                    <p class="si-play__error">{{ item.error ?: "Generation failed."|t('super-images') }}</p>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}

            {% if result.responsiveHtml %}
                <section class="si-play__code">
                    <h2 style="margin-top:0;">{{ "Live responsive HTML"|t('super-images') }}</h2>
                    <p class="light" style="margin-top:0;">
                        {{ "Multi-width srcset from this profile’s variants. Resize the browser to confirm the browser picks a matching width."|t('super-images') }}
                    </p>
                    <div class="si-play__live">
                        {{ result.responsiveHtml.markup|raw }}
                    </div>
                    <h3>{{ "Rendered markup"|t('super-images') }}</h3>
                    <pre><code>{{ result.responsiveHtml.pretty }}</code></pre>
                </section>
            {% endif %}

            <section class="si-play__code">
                <h2 style="margin-top:0;">{{ "Twig examples"|t('super-images') }}</h2>
                <h3>picture</h3>
                <pre><code>{{ result.code.twigPicture }}</code></pre>
                <h3>img</h3>
                <pre><code>{{ result.code.twigImg }}</code></pre>
                <h3>url</h3>
                <pre><code>{{ result.code.twigUrl }}</code></pre>
            </section>
        {% endif %}
    </div>
{% endblock %}
