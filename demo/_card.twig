{# Demo card: preview + copyable code tabs #}
{% set cardId = cardId|default('card-' ~ random()) %}
{% set codeLang = codeLang|default('twig') %}
<article
  class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-zinc-800/90 dark:bg-night-900/70 dark:shadow-[0_0_0_1px_rgba(255,255,255,0.02)]"
  x-data="{ tab: 'preview', copied: false }"
  id="{{ cardId }}"
>
  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-200 px-5 py-4 dark:border-zinc-800/80">
    <div class="min-w-0">
      <h3 class="text-base font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">{{ title }}</h3>
      {% if description is defined and description %}
        <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-500">{{ description|raw }}</p>
      {% endif %}
      {% if badges is defined and badges %}
        <div class="mt-2 flex flex-wrap gap-1.5">{{ badges|raw }}</div>
      {% endif %}
    </div>
    <div class="flex shrink-0 rounded-lg border border-slate-200 bg-slate-50 p-0.5 text-xs dark:border-zinc-700 dark:bg-night-950">
      <button type="button" class="rounded-md px-3 py-1.5 transition" :class="tab === 'preview' ? 'bg-white text-zinc-900 shadow-sm dark:bg-zinc-800 dark:text-white' : 'text-zinc-500'" @click="tab = 'preview'">Preview</button>
      <button
        type="button"
        class="rounded-md px-3 py-1.5 transition"
        :class="tab === 'code' ? 'bg-white text-zinc-900 shadow-sm dark:bg-zinc-800 dark:text-white' : 'text-zinc-500'"
        @click="tab = 'code'; $nextTick(() => window.siHighlight && window.siHighlight($root))"
      >Code</button>
    </div>
  </div>

  <div class="p-5" x-show="tab === 'preview'">
    <div class="demo-preview rounded-xl border border-dashed border-slate-200 bg-slate-50/80 p-3 dark:border-zinc-800 dark:bg-night-950/80">
      {% block preview %}{% endblock %}
    </div>
    {% if meta is defined and meta %}
      <div class="mt-3 flex flex-wrap gap-1.5">{{ meta|raw }}</div>
    {% endif %}
  </div>

  <div class="p-5" x-show="tab === 'code'" x-cloak>
    <div class="relative group">
      <button
        type="button"
        class="absolute right-2 top-2 z-10 rounded-md border border-slate-300 bg-white/90 px-2 py-1 text-[11px] font-medium text-zinc-600 hover:border-teal-500/50 hover:text-teal-700 dark:border-zinc-700 dark:bg-zinc-900/90 dark:text-zinc-300 dark:hover:text-teal-300"
        @click="
          const el = $el.parentElement.querySelector('code');
          navigator.clipboard.writeText(el.textContent);
          copied = true;
          setTimeout(() => copied = false, 1600);
        "
        x-text="copied ? 'Copied' : 'Copy'"
      ></button>
      <pre class="language-{{ codeLang }} overflow-x-auto rounded-xl border border-slate-200 bg-slate-50 p-4 text-[12px] leading-relaxed dark:border-zinc-800 dark:bg-zinc-950"><code class="language-{{ codeLang }} font-mono">{{ code|trim|e }}</code></pre>
    </div>
  </div>
</article>
