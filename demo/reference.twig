{% extends 'super-images/_layout.twig' %}
{% import 'super-images/_macros.twig' as ui %}

{% block title %}CLI & CP — Super Images Demo{% endblock %}

{% block intro %}
  <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-teal-700/80 dark:text-teal-400/80">Reference</p>
  <h2>CLI &amp; Control Panel</h2>
  <p class="mt-2">
    Diagnostics and batch generation live in the CP and Craft console.
    Full <code>config/super-images.php</code> schema is on the
    <a href="/super-images/config{{ assetQuery }}" class="text-teal-700 underline dark:text-teal-300">Configuration</a> page.
  </p>
{% endblock %}

{% block content %}
  <div class="space-y-8">
    <section class="rounded-2xl border border-slate-200 bg-white dark:border-zinc-800 dark:bg-night-900/60 p-6">
      <h3 class="text-lg font-semibold">Control Panel</h3>
      <ul class="mt-3 space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
        <li><strong class="text-zinc-800 dark:text-zinc-200">Dashboard</strong> — driver, formats, optimizers, storage, queue counts</li>
        <li><strong class="text-zinc-800 dark:text-zinc-200">Encoders &amp; Optimizers</strong> — quality + binary resolution</li>
        <li><strong class="text-zinc-800 dark:text-zinc-200">Playground</strong> — generate a profile’s variants × formats for an Asset</li>
        <li><strong class="text-zinc-800 dark:text-zinc-200">Diagnostics</strong> — same checks as <code class="text-teal-700 dark:text-teal-300">super-images/doctor</code></li>
        <li><strong class="text-zinc-800 dark:text-zinc-200">Settings</strong> — read-only effective config snapshot</li>
      </ul>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white dark:border-zinc-800 dark:bg-night-900/60 p-6">
      <h3 class="text-lg font-semibold">CLI</h3>
      {{ ui.codeBlock("php craft super-images/status
php craft super-images/doctor
php craft super-images/config --asset=123
php craft super-images/generate --asset=123 --profile=responsive --queue=1
php craft super-images/generate --volume=images --force=1
php craft super-images/cleanup --dry-run=1
php craft queue/listen", 'bash') }}
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white dark:border-zinc-800 dark:bg-night-900/60 p-6">
      <h3 class="text-lg font-semibold">Operations cheat sheet</h3>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="border-b border-slate-200 text-xs uppercase tracking-wider text-zinc-600 dark:border-zinc-800 dark:text-zinc-500">
            <tr>
              <th class="py-2 pr-4 font-medium">Type</th>
              <th class="py-2 pr-4 font-medium">Key options</th>
              <th class="py-2 font-medium">Drivers</th>
            </tr>
          </thead>
          <tbody class="font-mono text-[12px] text-zinc-700 dark:text-zinc-300">
            {% set rows = [
              ['fit / resize / scale', 'width, height, mode, factor', 'all'],
              ['crop / fill', 'width, height, position', 'all'],
              ['rotate / flip', 'angle, background · direction', 'all*'],
              ['grayscale / invert', '—', 'GD/Imagick (+vips gray)'],
              ['brightness / contrast', 'level | amount', 'all'],
              ['saturation / sepia', 'level · threshold', 'Imagick'],
              ['blur / sharpen', 'passes, radius, sigma · amount', 'all'],
              ['border / padding / background', 'size, color · sides', 'GD/Imagick'],
              ['watermark', 'path | text, opacity, angle, cover', 'Imagick'],
              ['overlay / text', 'path, x, y · content, size, position', 'Imagick'],
            ] %}
            {% for row in rows %}
              <tr class="border-b border-slate-200 dark:border-zinc-800/70">
                <td class="py-2.5 pr-4 text-teal-700 dark:text-teal-300/90">{{ row[0] }}</td>
                <td class="py-2.5 pr-4 text-zinc-600 dark:text-zinc-400">{{ row[1] }}</td>
                <td class="py-2.5 text-zinc-600 dark:text-zinc-500">{{ row[2] }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </div>
{% endblock %}
