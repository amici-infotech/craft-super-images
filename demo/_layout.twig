{% do craft.app.response.headers.set('X-Robots-Tag', 'noindex, nofollow') %}

{# Local sample first (many tryGenerate calls per page). Optional ?asset=ID overrides. #}
{% set localSampleWeb = craft.superImages.localDemoSource() %}
{% set cdnSample = 'https://picsum.photos/id/1015/1600/1000.jpg' %}
{% set assetId = craft.app.request.getQueryParam('asset') %}
{% set asset = assetId ? craft.assets.id(assetId).kind('image').one() : null %}
{% set demoSource = asset ?? (localSampleWeb ?? cdnSample) %}
{% set demoSourceCode = asset ? 'asset' : (localSampleWeb ? ("'" ~ localSampleWeb ~ "'") : ("'" ~ cdnSample ~ "'")) %}
{% set demoProfile = 'responsive' %}
{% set demoWidth = 640 %}
{% set demoFormat = 'jpg' %}
{% set assetQuery = asset ? '?asset=' ~ asset.id : '' %}
{% set nav = [
  { href: '/super-images', label: 'Overview', keywords: 'home start intro quick' },
  { href: '/super-images/delivery', label: 'Delivery API', keywords: 'url img picture srcset html markup lazy' },
  { href: '/super-images/formats', label: 'Formats', keywords: 'webp avif jpg png jpeg supportsFormat encode' },
  { href: '/super-images/geometry', label: 'Geometry', keywords: 'fit crop fill resize scale rotate flip position' },
  { href: '/super-images/color', label: 'Color', keywords: 'grayscale sepia invert brightness contrast saturation' },
  { href: '/super-images/effects', label: 'Effects', keywords: 'blur sharpen combo stack' },
  { href: '/super-images/composition', label: 'Composition', keywords: 'border padding background watermark text overlay logo' },
  { href: '/super-images/sources', label: 'Sources', keywords: 'asset id local path remote cdn url allowlist' },
  { href: '/super-images/generate', label: 'Generate API', keywords: 'tryGenerate generate result diagnostics enabled' },
  { href: '/super-images/config', label: 'Configuration', keywords: 'config profiles driver storage optimizers runtime delivery autoGenerate policies' },
  { href: '/super-images/reference', label: 'CLI & CP', keywords: 'cli doctor status cleanup queue playground diagnostics console' },
] %}
{% set navJson = nav|json_encode|raw %}
<!DOCTYPE html>
<html
  lang="en"
  class="h-full"
  x-data="{
    sidebarOpen: false,
    navSearch: '',
    navItems: {{ navJson }},
    dark: (localStorage.getItem('si-demo-theme') || 'dark') !== 'light',
    toggleTheme() {
      this.dark = !this.dark;
      localStorage.setItem('si-demo-theme', this.dark ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', this.dark);
    },
    get filteredNav() {
      const q = this.navSearch.trim().toLowerCase();
      if (!q) return this.navItems;
      return this.navItems.filter((item) => {
        const hay = (item.label + ' ' + (item.keywords || '')).toLowerCase();
        return hay.includes(q);
      });
    }
  }"
  x-init="document.documentElement.classList.toggle('dark', dark)"
  @keydown.escape.window="sidebarOpen = false"
>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Super Images Demo{% endblock %}</title>
  <script>
    (function () {
      try {
        if ((localStorage.getItem('si-demo-theme') || 'dark') !== 'light') {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"DM Sans"', 'ui-sans-serif', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'ui-monospace', 'SFMono-Regular', 'monospace'],
          },
          colors: {
            night: {
              950: '#070a0f',
              900: '#0c1118',
              850: '#111821',
              800: '#161e29',
            }
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
    .demo-preview img { max-width: 100%; height: auto; display: block; border-radius: 0.5rem; }
    .demo-preview picture, .demo-preview picture img { max-width: 100%; height: auto; display: block; }
    .prose-demo h2 { margin: 0 0 0.5rem; font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; color: #18181b; }
    .dark .prose-demo h2 { color: inherit; }
    .prose-demo h3 { margin: 1.5rem 0 0.4rem; font-size: 1.05rem; font-weight: 600; color: #3f3f46; }
    .dark .prose-demo h3 { color: #e4e4e7; }
    .prose-demo p { color: #52525b; line-height: 1.65; }
    .dark .prose-demo p { color: #a1a1aa; }
    .prose-demo code { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.85em; color: #0f766e; }
    .dark .prose-demo code { color: #5eead4; }
    /* Prism */
    pre[class*="language-"],
    code[class*="language-"] {
      font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace !important;
      font-size: 12px !important;
      line-height: 1.65 !important;
      text-shadow: none !important;
      background: transparent !important;
    }
    pre[class*="language-"] {
      margin: 0 !important;
      padding: 1rem !important;
      border-radius: 0.75rem !important;
      border: 1px solid #e2e8f0 !important;
      background: #f8fafc !important;
      overflow-x: auto !important;
    }
    .dark pre[class*="language-"] {
      border-color: rgb(39 39 42) !important;
      background: #09090b !important;
    }
    code[class*="language-"] .token.comment,
    code[class*="language-"] .token.prolog { color: #64748b; }
    .dark code[class*="language-"] .token.comment,
    .dark code[class*="language-"] .token.prolog { color: #71717a; }
    code[class*="language-"] .token.string,
    code[class*="language-"] .token.attr-value { color: #047857; }
    .dark code[class*="language-"] .token.string,
    .dark code[class*="language-"] .token.attr-value { color: #6ee7b7; }
    code[class*="language-"] .token.keyword,
    code[class*="language-"] .token.tag,
    code[class*="language-"] .token.boolean { color: #0f766e; }
    .dark code[class*="language-"] .token.keyword,
    .dark code[class*="language-"] .token.tag,
    .dark code[class*="language-"] .token.boolean { color: #5eead4; }
    code[class*="language-"] .token.function,
    code[class*="language-"] .token.class-name { color: #0369a1; }
    .dark code[class*="language-"] .token.function,
    .dark code[class*="language-"] .token.class-name { color: #7dd3fc; }
    code[class*="language-"] .token.number,
    code[class*="language-"] .token.operator { color: #b45309; }
    .dark code[class*="language-"] .token.number,
    .dark code[class*="language-"] .token.operator { color: #fcd34d; }
    code[class*="language-"] .token.punctuation { color: #64748b; }
    .dark code[class*="language-"] .token.punctuation { color: #a1a1aa; }
    code[class*="language-"] .token.property,
    code[class*="language-"] .token.atrule { color: #7c3aed; }
    .dark code[class*="language-"] .token.property,
    .dark code[class*="language-"] .token.atrule { color: #c4b5fd; }
  </style>
  {% block head %}{% endblock %}
</head>
<body class="min-h-full bg-slate-50 font-sans text-zinc-900 antialiased dark:bg-night-950 dark:text-zinc-100">
  <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute -left-24 top-0 h-80 w-80 rounded-full bg-teal-500/10 blur-3xl dark:bg-teal-500/10"></div>
    <div class="absolute right-0 top-40 h-96 w-96 rounded-full bg-cyan-600/10 blur-3xl dark:bg-cyan-600/5"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(226,232,240,0.9),_transparent_55%)] dark:bg-[radial-gradient(ellipse_at_top,_rgba(20,30,45,0.55),_transparent_55%)]"></div>
  </div>

  {# Mobile top bar #}
  <header class="sticky top-0 z-40 flex items-center gap-3 border-b border-slate-200 bg-white/90 px-4 py-3 backdrop-blur dark:border-zinc-800/80 dark:bg-night-950/90 lg:hidden">
    <button type="button" class="rounded-lg border border-slate-300 p-2 text-zinc-600 dark:border-zinc-700 dark:text-zinc-300" @click="sidebarOpen = true" aria-label="Open menu">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <div class="min-w-0 flex-1">
      <div class="text-sm font-semibold tracking-tight">Super Images</div>
      <div class="text-[11px] text-zinc-500">Plugin demo</div>
    </div>
    <button
      type="button"
      class="rounded-lg border border-slate-300 p-2 text-zinc-600 dark:border-zinc-700 dark:text-zinc-300"
      @click="toggleTheme()"
      :aria-label="dark ? 'Switch to light mode' : 'Switch to dark mode'"
    >
      <svg x-show="dark" x-cloak class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364-1.414 1.414M7.05 16.95l-1.414 1.414m12.728 0-1.414-1.414M7.05 7.05 5.636 5.636M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"/></svg>
      <svg x-show="!dark" x-cloak class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </header>

  <div class="mx-auto flex min-h-screen max-w-[1400px]">
    <div
      x-show="sidebarOpen"
      x-cloak
      class="fixed inset-0 z-40 bg-black/40 dark:bg-black/60 lg:hidden"
      @click="sidebarOpen = false"
    ></div>

    <aside
      class="fixed inset-y-0 left-0 z-50 flex w-72 -translate-x-full flex-col border-r border-slate-200 bg-white/95 backdrop-blur transition-transform dark:border-zinc-800/80 dark:bg-night-900/95 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0"
      :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'"
    >
      <div class="border-b border-slate-200 px-5 py-5 dark:border-zinc-800/80">
        <div class="flex items-start justify-between gap-2">
          <a href="/super-images{{ assetQuery }}" class="block min-w-0">
            <div class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-white">Super Images</div>
            <div class="mt-0.5 text-xs text-zinc-500">Interactive feature demo</div>
          </a>
          <button
            type="button"
            class="hidden rounded-lg border border-slate-300 p-2 text-zinc-600 transition hover:border-teal-500/50 hover:text-teal-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:text-teal-300 lg:inline-flex"
            @click="toggleTheme()"
            :aria-label="dark ? 'Switch to light mode' : 'Switch to dark mode'"
            :title="dark ? 'Light mode' : 'Dark mode'"
          >
            <svg x-show="dark" x-cloak class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364-1.414 1.414M7.05 16.95l-1.414 1.414m12.728 0-1.414-1.414M7.05 7.05 5.636 5.636M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"/></svg>
            <svg x-show="!dark" x-cloak class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>
        <div class="mt-4 space-y-2">
          <p class="rounded-lg border border-teal-500/20 bg-teal-500/10 px-3 py-2 text-[11px] leading-relaxed text-teal-800 dark:text-teal-200/90">
            {% if localSampleWeb %}
              Demo source: local file <code class="text-[10px]">{{ localSampleWeb }}</code> (from plugin <code class="text-[10px]">demo/assets/</code>).
            {% else %}
              Demo source: Picsum CDN — copy <code class="text-[10px]">demo/assets/super-images-demo.jpg</code> to <code class="text-[10px]">web/images/</code> to skip network.
            {% endif %}
          </p>
          <p class="truncate font-mono text-[10px] text-zinc-500" title="{{ demoSource }}">{{ demoSource }}</p>
          {% if asset %}
            <p class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-[11px] text-amber-800 dark:text-amber-200">
              Override active: Asset #{{ asset.id }} · {{ asset.filename }}
              <a href="{{ craft.app.request.pathInfo ? '/' ~ craft.app.request.pathInfo : '/super-images' }}" class="ml-1 underline">Clear</a>
            </p>
          {% endif %}
          <details class="text-[11px] text-zinc-500">
            <summary class="cursor-pointer select-none text-zinc-600 dark:text-zinc-400">Optional: override with Asset ID</summary>
            <form method="get" action="" class="mt-2 flex gap-2">
              <input
                type="number"
                name="asset"
                min="1"
                value="{{ asset ? asset.id : '' }}"
                placeholder="Asset ID"
                class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 font-mono text-xs text-zinc-800 outline-none focus:border-teal-500/60 dark:border-zinc-700 dark:bg-night-950 dark:text-zinc-200"
              >
              <button type="submit" class="shrink-0 rounded-lg bg-teal-500 px-3 py-2 text-xs font-semibold text-night-950 hover:bg-teal-400">Use</button>
            </form>
          </details>
          {% if craft.superImages.isEnabled() %}
            <span class="inline-flex rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-mono text-emerald-700 dark:text-emerald-300">plugin enabled</span>
          {% else %}
            <span class="inline-flex rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-[10px] font-mono text-amber-700 dark:text-amber-300">enabled = false</span>
          {% endif %}
        </div>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 py-4">
        <label class="mb-2 block px-2">
          <span class="mb-1 block text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-400 dark:text-zinc-600">Search</span>
          <input
            type="search"
            x-model="navSearch"
            @keydown.enter.prevent="if (filteredNav.length) { window.location.href = filteredNav[0].href + '{{ assetQuery|e('js') }}'; }"
            placeholder="geometry, watermark, config…"
            class="w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-xs text-zinc-800 outline-none focus:border-teal-500/60 dark:border-zinc-700 dark:bg-night-950 dark:text-zinc-200"
          >
        </label>
        <p class="mb-2 px-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-400 dark:text-zinc-600">Browse</p>
        <ul class="space-y-1">
          <template x-for="item in filteredNav" :key="item.href">
            <li>
              <a
                :href="item.href + '{{ assetQuery|e('js') }}'"
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition text-zinc-600 hover:bg-slate-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800/60 dark:hover:text-zinc-100"
                :class="window.location.pathname.replace(/\/$/, '') === item.href ? 'bg-teal-500/15 text-teal-800 ring-1 ring-teal-500/30 dark:text-teal-200' : ''"
                @click="sidebarOpen = false"
              >
                <span class="font-medium" x-text="item.label"></span>
              </a>
            </li>
          </template>
        </ul>
        <p x-show="filteredNav.length === 0" x-cloak class="px-3 py-2 text-xs text-zinc-500">No matching pages.</p>
      </nav>

      <div class="border-t border-slate-200 px-5 py-4 dark:border-zinc-800/80">
        <p class="text-[11px] leading-relaxed text-zinc-500 dark:text-zinc-600">
          Demo templates · Tailwind · Alpine · Prism
        </p>
      </div>
    </aside>

    <main class="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-10 lg:py-10">
      <div class="prose-demo mb-8 max-w-3xl">
        {% block intro %}{% endblock %}
      </div>

      {% block content %}{% endblock %}
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-markup-templating.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-twig.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-php.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-bash.min.js"></script>
  <script>
    window.siHighlight = function (root) {
      if (!window.Prism) return;
      Prism.highlightAllUnder(root || document);
    };
    document.addEventListener('DOMContentLoaded', function () {
      window.siHighlight();
    });
  </script>
</body>
</html>
